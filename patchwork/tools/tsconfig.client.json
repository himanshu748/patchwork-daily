{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "jsx": "react-jsx",
    "customConditions": ["browser"],
    "types": [],
    "rootDir": "../src/client",
    "outDir": "../node_modules/.tmp/client",
    "tsBuildInfoFile": "../node_modules/.tmp/client/tsconfig.tsbuildinfo"
  },
  "include": ["../src/client/**/*"],
