{
  "name": "patchwork",
  "version": "0.0.0",
  "private": true,
  "license": "BSD-3-Clause",
  "type": "module",
  "description": "Patchwork: a daily community nonogram mosaic for Reddit (Devvit Web).",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "build": "tsc --build && vite build && node tools/check-bundle.mjs",
    "deploy": "npm run test:types && npm run lint && devvit upload",
    "dev": "devvit playtest",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "login": "devvit login",
    "prettier": "prettier --write .",
    "test": "vitest --run",
    "test:types": "tsc --build"
  },
  "dependencies": {
    "@devvit/analytics": "0.15.4",
    "@devvit/start": "0.15.4",
    "@devvit/web": "0.15.4",
    "@hono/node-server": "2.1.6",
    "devvit": "0.15.4",
    "hono": "4.13.17",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@devvit/test": "0.15.4",
    "@eslint/js": "10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fast-check": "^4.3.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vitest": "^5.1.0"
  }
}
